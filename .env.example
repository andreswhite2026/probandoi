# ===========================================================================
# SismoWatch - plantilla de variables de entorno
# ---------------------------------------------------------------------------
# USO: cp .env.example .env  y reemplazar TODOS los valores marcados CAMBIAR.
# El archivo .env NUNCA se versiona (ver .gitignore).
# Los valores de este ejemplo son placeholders de desarrollo, no credenciales.
# Puertos del host elegidos para no chocar con otros stacks locales.
# ===========================================================================

COMPOSE_PROJECT_NAME=sismowatch
TZ=UTC

# ---------------------------------------------------------------------------
# PostgreSQL (base de datos operativa y de serving)
# ---------------------------------------------------------------------------
# PostgreSQL NO publica puertos al host: solo es accesible desde la red interna
# de Docker. Para inspeccionarlo: make psql / make psql-api
POSTGRES_DB=sismowatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CAMBIAR_password_superusuario

# Base de metadatos de Airflow (separada de los datos de negocio)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_meta
AIRFLOW_DB_PASSWORD=CAMBIAR_password_airflow_meta

# Roles de minimo privilegio (se crean en db/init)
SISMO_INGEST_USER=sismo_ingest
SISMO_INGEST_PASSWORD=CAMBIAR_password_ingesta
SISMO_TRANSFORM_USER=sismo_transform
SISMO_TRANSFORM_PASSWORD=CAMBIAR_password_transformacion
SISMO_API_USER=sismo_api
SISMO_API_PASSWORD=CAMBIAR_password_api

# ---------------------------------------------------------------------------
# MinIO (data lake S3-compatible)
# ---------------------------------------------------------------------------
# MinIO NO publica puertos al host (API ni consola). Se inspecciona con
# `make minio-ls` o `docker compose run --rm ...` dentro de la red interna.
MINIO_ROOT_USER=sismo_root
MINIO_ROOT_PASSWORD=CAMBIAR_password_root_minio
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1

SISMO_BRONZE_BUCKET=sismowatch-bronze
SISMO_SILVER_BUCKET=sismowatch-silver

# Usuarios de servicio de MinIO (permisos acotados a su bucket/prefijo)
MINIO_INGEST_USER=sismo_ingest_svc
MINIO_INGEST_PASSWORD=CAMBIAR_password_minio_ingesta
MINIO_SPARK_USER=sismo_spark_svc
MINIO_SPARK_PASSWORD=CAMBIAR_password_minio_spark

# ---------------------------------------------------------------------------
# Apache Airflow
# ---------------------------------------------------------------------------
AIRFLOW_HOST_PORT=8082
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CAMBIAR_password_airflow
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CAMBIAR_clave_fernet
AIRFLOW_SECRET_KEY=CAMBIAR_secret_key_airflow

# ---------------------------------------------------------------------------
# API (FastAPI)
# ---------------------------------------------------------------------------
API_HOST_PORT=8000
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_secreto_jwt
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# Usuarios semilla de la plataforma (se crean al iniciar la API si no existen)
ADMIN_EMAIL=admin@sismowatch.local
ADMIN_PASSWORD=CAMBIAR_password_admin_app
VIEWER_EMAIL=viewer@sismowatch.local
VIEWER_PASSWORD=CAMBIAR_password_viewer_app

# ---------------------------------------------------------------------------
# IA (Ollama local por defecto; sin API keys)
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma:2b
AI_TIMEOUT_SECONDS=120
AI_PROMPT_VERSION=v1

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
WEB_HOST_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# OpenMetadata (profile "governance": no se levanta en el up base)
# ---------------------------------------------------------------------------
OM_VERSION=2.0.6
OPENMETADATA_HOST_PORT=8585
OM_OPENSEARCH_HOST_PORT=9201
OM_MYSQL_HOST_PORT=3307
OM_DB_USER=openmetadata
OM_DB_PASSWORD=CAMBIAR_password_om_db
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=CAMBIAR_password_om_admin
OM_JWT_TOKEN_URI=http://openmetadata-server:8585/api/v1/users/login
OM_JWT_TOKEN=CAMBIAR_token_om
